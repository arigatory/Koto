<Project>
  <!-- Chain to root Directory.Build.props -->
  <Import Project="$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))" />

  <PropertyGroup>
    <Version>0.5.0-preview.1</Version>
    <Authors>Ivan Panchenko</Authors>
    <Company>Ivan Panchenko</Company>
    <Copyright>Copyright © 2026 Ivan Panchenko</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/arigatory/Koto</PackageProjectUrl>
    <RepositoryUrl>https://github.com/arigatory/Koto</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>ddd;cqrs;domain;microservices;dotnet</PackageTags>
    <PackageReleaseNotes>0.5.0-preview.1 — new error model: abstract Error catalog, AppResult for handlers, one Envelope response for every transport (ADR-026). Breaking for 0.4 consumers; migration guide: https://github.com/arigatory/Koto/blob/main/docs/migrations/0.4-to-0.5.md</PackageReleaseNotes>

    <!-- XML docs for IntelliSense -->
    <GenerateDocumentationFile>true</GenerateDocumentationFile>

    <!-- Libraries must not capture the sync context: CA2007 (missing ConfigureAwait) is an error.
         The rule itself is enabled in src/.editorconfig. -->
    <AnalysisLevel>latest</AnalysisLevel>
    <WarningsAsErrors>$(WarningsAsErrors);CA2007</WarningsAsErrors>

    <!-- Symbol package for debugging -->
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>

    <!-- SourceLink: provided by the .NET SDK (8+) — no explicit Microsoft.SourceLink.* package needed -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
  </PropertyGroup>

</Project>
