<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Koto.Validation</PackageId>
    <Description>FluentValidation extensions for Koto: MustBeValueObject, MustBeEntity, ListMustContainNumberOfItems, and ValidationBehavior pipeline integration.</Description>
    <PackageTags>ddd;fluentvalidation;validation;pipeline;valueobject;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koto.Domain\Koto.Domain.csproj" />
    <ProjectReference Include="..\Koto.Application\Koto.Application.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FluentValidation" Version="[12.0.0,13.0.0)" />
  </ItemGroup>

</Project>
