<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageId>Koto.Api.FastEndpoints</PackageId>
    <Description>FastEndpoints integration for Koto: CQRS base endpoints responding with the Koto Envelope, binding errors in the same envelope, correlation ID middleware, and global exception handler.</Description>
    <PackageTags>ddd;fastendpoints;cqrs;api;envelope;microservices;dotnet</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\"/>
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FastEndpoints" Version="5.35.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Koto.Api.AspNetCore\Koto.Api.AspNetCore.csproj" />
    <ProjectReference Include="..\Koto.Application\Koto.Application.csproj" />
    <ProjectReference Include="..\Koto.Validation\Koto.Validation.csproj" />
  </ItemGroup>

</Project>
